{
  "name": "conecta-page-2026",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:site": "docker compose run --rm web sh -c 'bundle install && ruby scripts/validate_agenda.rb && bundle exec jekyll build'",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:a11y",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e/journey.spec.js",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "security:links": "ruby scripts/validate_external_links.rb",
    "security:audit": "bash scripts/security_audit.sh",
    "security:ci": "npm audit --audit-level=critical && ruby scripts/validate_external_links.rb"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "http-server": "^14.1.1",
    "vitest": "^4.1.8"
  }
}

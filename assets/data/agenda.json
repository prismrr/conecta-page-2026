---
layout: null
---
[
{% assign sessions = site.agenda | sort: "startTime" %}
{% for s in sessions %}
  {
    "id": {{ s.id | jsonify }},
    "title": {{ s.title | jsonify }},
    "speaker": {{ s.speaker | jsonify }},
    "track": {{ s.track | jsonify }},
    "startTime": {{ s.startTime | jsonify }},
    "endTime": {{ s.endTime | jsonify }},
    "room": {{ s.room | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
